# Configuración de Servidor Apache para domingoisain.cl
# Habilitar RewriteEngine para rutas limpias y compatibilidad SEO

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /domingoisain/

    # Si se accede desde la raíz del dominio principal directamente
    # RewriteBase /

    # Forzar trailing slash en carpetas o redirigir index.php a raíz
    RewriteCond %{THE_REQUEST} ^.*/index\.php 
    RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

    # Servir archivos y directorios estáticos existentes directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Enrutar todas las demás URLs limpias a index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Compresión Gzip para alto rendimiento y Core Web Vitals
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching de activos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Encabezados de Seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
